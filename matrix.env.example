# Target Matrix room.
MATRIX_ROOM_ID=!roomid:matrix.example.org

# Direct Matrix Client API transport (suitable for unencrypted rooms).
MATRIX_HOMESERVER=https://matrix.example.org
MATRIX_ACCESS_TOKEN=replace-with-an-access-token

# For encrypted rooms, prefer the `auckland-bin-matrix-login` command,
# which provisions a separate matrix-nio SDK device and crypto store.
# The legacy MCP path is retained as a fallback during migration.
# MATRIX_MCP_URL=http://127.0.0.1:8000/mcp

# Optional for encrypted rooms with unverified devices (encryption stays enabled).
# Only enable for low-sensitivity messages; permits sharing keys with unverified devices.
# MATRIX_IGNORE_UNVERIFIED_DEVICES=true

# Provisioned automatically by `auckland-bin-matrix-login`, do not clone a live MCP device.
# MATRIX_TRANSPORT=nio
# MATRIX_USER_ID=@you:example.org
# MATRIX_DEVICE_ID=YOUR_DEDICATED_DEVICE
# MATRIX_SDK_STORE_PATH=~/.local/state/auckland-bin-notifier/matrix-sdk
