# Choose exactly one collection source.

# Option A: Auckland Council property ID (11 digits).
AUCKLAND_BIN_PROPERTY_ID=00000000000

# Option B: direct iCalendar/webcal feed.
# AUCKLAND_BIN_ICS_URL=https://example.invalid/bin-calendar.ics

# Optional state/cache locations. Tilde expansion is supported.
# AUCKLAND_BIN_STATE=~/.local/state/auckland-bin-notifier/state.json
# AUCKLAND_BIN_ICS_CACHE=~/.local/state/auckland-bin-notifier/latest.ics

# Optional encrypted personal reminder from a separately configured Matrix SDK bot.
# AUCKLAND_BIN_DM_ENV=~/.config/beszel-alerts/matrix-sdk.env
# AUCKLAND_BIN_DM_USER_ID=@beszel:matrix.presley.nz
# AUCKLAND_BIN_DM_ROOM_ID=!verified-private-room:matrix.presley.nz
# Opt in for encrypted DMs to newly added, unverified owner devices.
# AUCKLAND_BIN_DM_IGNORE_UNVERIFIED_DEVICES=true
