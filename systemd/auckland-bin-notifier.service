[Unit]
Description=Auckland Council bin-day Matrix notifier
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=%h/.config/auckland-bin-notifier/matrix.env
EnvironmentFile=%h/.config/auckland-bin-notifier/config.env
ExecStart=%h/.local/bin/auckland-bin-notifier
NoNewPrivileges=true
PrivateTmp=true
